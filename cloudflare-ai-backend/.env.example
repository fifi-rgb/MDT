# Do not commit this file to version control

# Cloudflare Account ID (get from Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# KV Namespace IDs (created via: wrangler kv:namespace create CONVERSATIONS)
KV_NAMESPACE_ID=your_kv_namespace_id
KV_PREVIEW_NAMESPACE_ID=your_preview_kv_namespace_id

# D1 Database ID (created via: wrangler d1 create authieticket_db)
D1_DATABASE_ID=your_d1_database_id

# API Endpoint (for frontend)
REACT_APP_AI_API_ENDPOINT=https://your-worker.your-subdomain.workers.dev

# Environment
ENVIRONMENT=development
